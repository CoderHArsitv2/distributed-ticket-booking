# Copy to .env and adjust. Loaded via your shell / a dotenv tool.

HTTP_PORT=8080

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ticketing?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m

# Redis (distributed lock strategy)
REDIS_URL=redis://localhost:6379/0

# Concurrency control: pessimistic | optimistic | distributed
LOCK_STRATEGY=pessimistic

# Reservation hold window and sweeper cadence
HOLD_TTL=10m
SWEEP_EVERY=30s
